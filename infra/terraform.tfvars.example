# Copy to terraform.tfvars (gitignored) and fill in.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Authentication is NOT configured here. The default is the Azure CLI:
#
#   az login --tenant <tenant guid>
#
# Credentials never belong in this file. For a service principal, export
# FABRIC_CLIENT_ID / FABRIC_CLIENT_SECRET instead (see README.md).

# --- Authentication ----------------------------------------------------------
# Optional under CLI auth - `az login --tenant` already pins the tenant.
# tenant_id = "00000000-0000-0000-0000-000000000000"

# Defaults: CLI on, OIDC off, no service principal.
# use_cli  = true
# use_oidc = false

# --- Capacity ----------------------------------------------------------------
# The capacity's DISPLAY NAME. You must be a capacity admin. List them with:
#   az rest --method get --url https://api.fabric.microsoft.com/v1/capacities \
#     --resource https://api.fabric.microsoft.com --query "value[].displayName"
capacity_name = "myfabriccapacity"

# Escape hatch for principals that cannot list capacities (CI). Set exactly one
# of capacity_name / capacity_id.
# capacity_id = "00000000-0000-0000-0000-000000000000"

# --- Service principal -------------------------------------------------------
# The OBJECT id (not the client id): az ad sp show --id <appId> --query id -o tsv
# Required only while any environment below sets dbt_sp_role. Leave it out and
# set every dbt_sp_role to null when running as yourself over the CLI.
# dbt_service_principal_object_id = "00000000-0000-0000-0000-000000000000"

# --- Naming ------------------------------------------------------------------
workspace_prefix = "dbt-accelerator"
# source_lakehouse_name = "LH_source"
# code_lakehouse_name   = "LH_dbt_code"

# --- Environments ------------------------------------------------------------
# The default provisions dev / ci / accept / prod exactly as the pipelines
# expect, with dbt_sp_role = "Contributor" on ci/accept/prod. Override it to
# drop the role assignments until the service principal exists.
#
# environments = {
#   dev    = { dbt_sp_role = null }
#   ci     = { dbt_sp_role = null }
#   accept = { dbt_sp_role = null, deploy_target = true }
#   prod   = { dbt_sp_role = null, deploy_target = true }
# }
