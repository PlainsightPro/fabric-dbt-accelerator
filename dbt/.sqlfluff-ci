[sqlfluff]
dialect = tsql
# dbt templater (sqlfluff-templater-dbt): compiles through dbt itself, so
# macros resolve exactly as they do in a real run - including target-dependent
# ones like limit_ci_rows. The jinja templater only loads macros/ into a flat
# namespace and renders them without a target.
templater = dbt
max_line_length = 120
# Headroom over the 255 default; this is only sqlfluff's anti-DoS guard, and
# nothing here comes close now that surrogate_key_bigint hashes in one pass.
max_parse_depth = 500
exclude_rules = L009

[sqlfluff:templater:dbt]
# Run sqlfluff from the dbt/ folder (this file's directory); both resolve to it.
project_dir = .
profiles_dir = .
# The four silver models are incremental, and is_incremental() resolves
# adapter.get_relation() against the warehouse, so compiling them needs a live
# connection. The ci target authenticates with the service principal, so this
# works both in the pipelines and locally from .env - unlike dev, which would
# require `az login`.
target = ci

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit
