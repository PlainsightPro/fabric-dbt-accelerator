# Copy this file to profiles.yml (gitignored) and adjust for your environment.
#
# Environment strategy:
#   dev    - personal developer environment, Azure CLI auth (run `az login` first).
#            All schemas are prefixed with dev_<your username> via generate_schema_name.
#   ci     - dedicated Fabric CI workspace, Service Principal auth.
#            Used by the PR validation pipelines (Azure DevOps / GitHub Actions).
#   accept - stable acceptance environment, Service Principal auth, scheduled runs only.
#   prod   - production environment, Service Principal auth, scheduled runs only.
#
# All credentials and endpoints come from environment variables so this file
# never contains secrets. The pipelines inject the values per environment:
#   DBT_FABRIC_HOST       - Fabric warehouse SQL endpoint
#   DBT_FABRIC_DATABASE   - Fabric warehouse name
#   DBT_SP_TENANT_ID      - Entra ID tenant id
#   DBT_SP_CLIENT_ID      - service principal application (client) id
#   DBT_SP_CLIENT_SECRET  - service principal client secret

fabric_dbt_accelerator:
  target: dev
  outputs:
    dev:
      type: fabric
      driver: ODBC Driver 18 for SQL Server
      host: "{{ env_var('DBT_FABRIC_HOST', '<your-dev-warehouse-sql-endpoint>') }}"
      database: "{{ env_var('DBT_FABRIC_DATABASE', '<your-dev-warehouse-name>') }}"
      # Personal schema prefix: USERNAME on Windows, USER on macOS/Linux.
      # generate_schema_name appends the layer schema, e.g. dev_jdoe_staging_sales.
      schema: "dev_{{ env_var('USERNAME', env_var('USER', 'developer')) | lower | replace(' ', '_') }}"
      authentication: CLI
      threads: 4

    ci:
      type: fabric
      driver: ODBC Driver 18 for SQL Server
      host: "{{ env_var('DBT_FABRIC_HOST') }}"
      database: "{{ env_var('DBT_FABRIC_DATABASE') }}"
      schema: dbo
      authentication: ServicePrincipal
      tenant_id: "{{ env_var('DBT_SP_TENANT_ID') }}"
      client_id: "{{ env_var('DBT_SP_CLIENT_ID') }}"
      client_secret: "{{ env_var('DBT_SP_CLIENT_SECRET') }}"
      threads: 4

    accept:
      type: fabric
      driver: ODBC Driver 18 for SQL Server
      host: "{{ env_var('DBT_FABRIC_HOST') }}"
      database: "{{ env_var('DBT_FABRIC_DATABASE') }}"
      schema: dbo
      authentication: ServicePrincipal
      tenant_id: "{{ env_var('DBT_SP_TENANT_ID') }}"
      client_id: "{{ env_var('DBT_SP_CLIENT_ID') }}"
      client_secret: "{{ env_var('DBT_SP_CLIENT_SECRET') }}"
      threads: 4

    prod:
      type: fabric
      driver: ODBC Driver 18 for SQL Server
      host: "{{ env_var('DBT_FABRIC_HOST') }}"
      database: "{{ env_var('DBT_FABRIC_DATABASE') }}"
      schema: dbo
      authentication: ServicePrincipal
      tenant_id: "{{ env_var('DBT_SP_TENANT_ID') }}"
      client_id: "{{ env_var('DBT_SP_CLIENT_ID') }}"
      client_secret: "{{ env_var('DBT_SP_CLIENT_SECRET') }}"
      threads: 8
